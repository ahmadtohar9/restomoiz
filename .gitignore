# Konfigurasi per-server
.env
.user.ini

# Runtime
/application/cache/*
!/application/cache/index.html
!/application/cache/.htaccess
/application/logs/*
!/application/logs/index.html
/application/sessions/*
!/application/sessions/index.html
/public/uploads/*
!/public/uploads/index.html
!/public/uploads/.htaccess

# Dokumen internal (PRD tidak ikut repo publik)
PRD_*.md

# Editor / OS
.DS_Store
.idea/
.vscode/
/vendor/

# File privat (invoice, bukti bayar, surat jalan) - di luar document root
/storage/*
!/storage/.htaccess
!/storage/index.html
