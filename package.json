{
  "name": "restomoiz-assets",
  "private": true,
  "description": "Build aset front-end (Tailwind CSS & vendor offline). Hasil build di-commit, server produksi tidak butuh Node.js.",
  "scripts": {
    "vendor": "node tools/copy-vendor.js",
    "build:bootstrap": "sass --load-path=node_modules --no-source-map --style=compressed --quiet-deps resources/scss/bootstrap.scss public/assets/vendor/bootstrap/bootstrap.min.css",
    "build:css": "tailwindcss -i resources/css/app.css -o public/assets/css/app.css --minify",
    "watch:css": "tailwindcss -i resources/css/app.css -o public/assets/css/app.css --watch",
    "build": "npm run vendor && npm run build:bootstrap && npm run build:css"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "bootstrap": "5.3.3",
    "bootstrap-icons": "1.11.3",
    "sass": "^1.77.8",
    "tailwindcss": "^3.4.17"
  }
}
