# Salin ke .env lalu isi. File .env TIDAK boleh masuk git.
CI_ENV=production
APP_URL=https://www.resto.moizcare.id/
# Buat dengan: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# Database KHUSUS resto (terpisah dari moizhospitalapps)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=moizresto_db
DB_USER=moizresto
DB_PASS=

# Zona waktu aplikasi, samakan dengan zona waktu server MySQL
APP_TIMEZONE=Asia/Jakarta

# true kalau situs diakses lewat HTTPS
COOKIE_SECURE=true
